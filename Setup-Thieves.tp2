BACKUP ~Thieves Item Pack/Backup~
AUTHOR ~Greener~
VERSION ~1.2~

AUTO_EVAL_STRINGS

LANGUAGE
  ~English~
  ~english~
  ~Thieves Item Pack/Language/English/game.tra~
  ~Thieves Item Pack/Language/English/weidu.tra~

BEGIN @1
REQUIRE_PREDICATE ENGINE_IS ~bgee bg2ee~ @2
ACTION_IF FILE_EXISTS_IN_GAME ~enginest.2da~ THEN BEGIN
COPY ~Thieves Item Pack/Items/RING36.ITM~ ~override~ // Ring of Danger Sense
  SAY NAME2 @3
  SAY DESC @4

COPY ~Thieves Item Pack/Effects/SW1H10A.EFF~ ~override~ 
COPY ~Thieves Item Pack/Effects/SW1H10B.EFF~ ~override~ 
COPY ~Thieves Item Pack/Items/SW1H10.ITM~ ~override~ // Short Sword of Backstabbing (PnP)
  SAY NAME2 @5
  SAY DESC @6

COPY ~Thieves Item Pack/Spells/MISC75A.SPL~ ~override~ 
COPY ~Thieves Item Pack/Spells/MISC75B.SPL~ ~override~ 
COPY ~Thieves Item Pack/Items/MISC75.ITM~ ~override~ // Dagger of Venom (PnP)
  SAY NAME2 @7
  SAY DESC @8
END

ACTION_IF FILE_EXISTS_IN_GAME ~cdievad.spl~ THEN BEGIN
COPY ~Thieves Item Pack/Items/RING50.ITM~ ~override~ // Ring of Evasion
  SAY NAME2 @9
  SAY DESC @10
END

ACTION_IF GAME_IS ~bgee~ THEN BEGIN
COPY_EXISTING ~taerum.sto~ ~override/TAERUM.STO~ // Thunderhammer Smithy
  REMOVE_STORE_ITEM ~LEAT08~  // Remove Shadow Armor from Thunderhammer Smithy
  REMOVE_STORE_ITEM ~MISC75~  // Remove Dagger of Venom  from Thunderhammer Smithy

COPY_EXISTING ~stoblack.sto~ ~override/STOBLACK.STO~ // Black Lily
  REMOVE_STORE_ITEM ~LEAT02~
  ADD_STORE_ITEM ~LEAT02~   AFTER  ~LEAT01~ #1 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~RING36~   AFTER  ~CLCK01~ #1 #0 #0 ~IDENTIFIED~ #1 // Add Ring of Danger Sense to Black Lily
  ADD_STORE_ITEM ~LEAT08~   AFTER  ~LEAT05~ #1 #0 #0 ~IDENTIFIED~ #1 // Add Shadow Armor to Black Lily
  ADD_STORE_ITEM ~MISC75~   AFTER  ~DAGG01~ #1 #0 #0 ~IDENTIFIED~ #1 // Add Dagger of Venom to Black Lily
END

ACTION_IF GAME_IS ~bgee~ THEN BEGIN
ACTION_IF FILE_EXISTS_IN_GAME ~cdievad.spl~ THEN BEGIN
COPY_EXISTING ~BLACKL.CRE~ ~override~	// Black Lily
  ADD_CRE_ITEM ~RING50~ #0 #0 #0 ~UNSTEALABLE~ ~LRING~ // Add Ring of Evasion to Black Lily
END
END 

ACTION_IF GAME_IS ~bg2ee~ THEN BEGIN
COPY_EXISTING ~SEVPAT05.CRE~ ~override~	// Brennan Risling
  REPLACE_CRE_ITEM ~RING36~ #0 #0 #0 ~UNSTEALABLE~ ~LRING~ // Add Ring of Danger Sense to Brenan Risling
END

ACTION_IF GAME_IS ~bg2ee~ THEN BEGIN
ACTION_IF FILE_EXISTS_IN_GAME ~cdievad.spl~ THEN BEGIN
COPY_EXISTING ~HLKOSHI.CRE~ ~override~	// Koshi
  ADD_CRE_ITEM ~RING50~ #0 #0 #0 ~UNSTEALABLE~ ~LRING~ // Add Ring of Evasion to Koshi
END
END